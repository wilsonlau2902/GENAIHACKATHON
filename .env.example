# Copy to .env and fill values. DO NOT commit your .env file.

# --- WorkBuddy keyless LLM (recommended for public deployment) ---
# These values come from workbuddy_cloud_service activation (publicConfig).
# VITE_WBCLOUD_ENDPOINT=https://your-app.workbuddy.link
# VITE_WBCLOUD_KEY=your_publishable_key

# --- Legacy: self-hosted proxy server (server/proxy.js) ---
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# PORT=3001
# Optional configuration for other providers:
# API_KEY=your_key_here
# API_BASE_URL=https://api.your-provider.com
# API_CHAT_PATH=/v1/chat/completions
# API_KEY_HEADER=Authorization
# API_KEY_PREFIX=Bearer
